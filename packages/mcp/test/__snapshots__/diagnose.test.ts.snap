// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`testlease_diagnose over Streamable HTTP (mounted on the TestLease server) > lists testlease_diagnose with read-only annotations; existing tools are unchanged > existing tools (http) 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Acquires an exclusive lease on one resource of the pool that matches the tags. Returns lease id, resource metadata and the names of available secrets (never values). Fails fast with POOL_EXHAUSTED unless waitSeconds > 0. Reusing the same clientRequestId returns the same lease instead of a second one.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "clientRequestId": {
          "description": "Idempotency key; repeat it when retrying",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "pool": {
          "description": "Pool name, e.g. "premium-buyers"",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "purpose": {
          "description": "Why you need it, shown to humans in diagnostics",
          "maxLength": 500,
          "type": "string",
        },
        "tags": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Required resource tags, e.g. {"region":"nl"}",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "ttlSeconds": {
          "description": "Lease TTL; defaults to the pool default. Renew before it elapses.",
          "maximum": 604800,
          "minimum": 1,
          "type": "integer",
        },
        "waitSeconds": {
          "description": "How long to wait for a free resource (0-120, default 0).",
          "maximum": 120,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "pool",
      ],
      "type": "object",
    },
    "name": "testlease_acquire",
    "title": "Acquire a resource lease",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Returns the current state of a lease (ACTIVE, RELEASED or EXPIRED) and its resource snapshot.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "leaseId": {
          "description": "Lease id returned by testlease_acquire, e.g. "lease_ab12..."",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "leaseId",
      ],
      "type": "object",
    },
    "name": "testlease_get_lease",
    "title": "Get a lease",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Returns the evidence trail of a lease: acquired, renewed, released, expired, quarantined.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "leaseId": {
          "description": "Lease id returned by testlease_acquire, e.g. "lease_ab12..."",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "leaseId",
      ],
      "type": "object",
    },
    "name": "testlease_lease_events",
    "title": "Lease event history",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Lists every pool with available/leased/quarantined counts and how many callers are waiting.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "testlease_list_pools",
    "title": "List resource pools",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Shows every resource in a pool with its state, tags, current owner and lease expiry, plus who is waiting.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "pool": {
          "description": "Pool name, e.g. "premium-buyers"",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "pool",
      ],
      "type": "object",
    },
    "name": "testlease_pool_status",
    "title": "Inspect a pool",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Returns the resource to the pool. Idempotent: releasing an already released or expired lease is harmless.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "leaseId": {
          "description": "Lease id returned by testlease_acquire, e.g. "lease_ab12..."",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "leaseId",
      ],
      "type": "object",
    },
    "name": "testlease_release",
    "title": "Release a lease",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Extends the expiry of a lease you own. Call it before the TTL elapses during long work.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "leaseId": {
          "description": "Lease id returned by testlease_acquire, e.g. "lease_ab12..."",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "ttlSeconds": {
          "maximum": 604800,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "leaseId",
      ],
      "type": "object",
    },
    "name": "testlease_renew",
    "title": "Renew (heartbeat) a lease",
  },
]
`;

