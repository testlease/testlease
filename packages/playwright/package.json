{
  "name": "@testlease/playwright",
  "version": "0.1.0",
  "description": "Playwright fixtures for TestLease: worker- and test-scoped exclusive resources with heartbeat, release and sanitized evidence",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
