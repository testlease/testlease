{
  "name": "@testlease/client",
  "version": "0.1.0",
  "description": "TypeScript client for TestLease: acquire, heartbeat, release and quarantine shared test resources",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/testlease/testlease.git",
    "directory": "packages/client"
  },
  "keywords": [
    "testlease",
    "testing",
    "lease",
    "resource-pool",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@testlease/protocol": "workspace:*"
  }
}
