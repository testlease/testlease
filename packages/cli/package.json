{
  "name": "testlease",
  "version": "0.2.1",
  "description": "Stop parallel tests from fighting over shared test accounts and environments. Server + CLI for TestLease.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "testlease": "./bin/testlease.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/testlease/testlease.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "testlease",
    "testing",
    "lease",
    "resource-pool",
    "cli",
    "playwright",
    "mcp",
    "flaky-tests"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@testlease/client": "workspace:*",
    "@testlease/core": "workspace:*",
    "@testlease/mcp": "workspace:*",
    "@testlease/protocol": "workspace:*",
    "@testlease/server": "workspace:*",
    "commander": "15.0.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  }
}
